# Public base URL of the independent materials API, with no trailing slash.
# Leave unset until a real backend is available. No requests or sample data then.
# A same-origin path such as /api is also supported.
# Never put an API token or secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_MATERIALS_API_BASE=
# Optional dedicated, bounded public preview endpoint, relative to the API base.
NEXT_PUBLIC_MATERIALS_PREVIEW_PATH=

# Same-origin authentication BFF. Leave empty until the real service is ready.
NEXT_PUBLIC_AUTH_API_BASE=
# Same-origin contribution service. Leave blank for browser-only drafts.
NEXT_PUBLIC_CONTRIBUTIONS_API_BASE=
# Explicit local test opt-in. Ignored in production and outside loopback hosts.
NEXT_PUBLIC_ENABLE_LOCAL_ACCOUNTS=false
# Explicit public demo opt-in, including production builds. Browser-local data only.
# Keep AUTH_API_BASE empty for demos; a configured real identity service takes precedence.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
